CREATE TABLE IF NOT EXISTS CachedTeam (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    logoUrl TEXT,
    leaderName TEXT,
    point INTEGER NOT NULL DEFAULT 0,
    status TEXT NOT NULL DEFAULT 'active'
);

CREATE TABLE IF NOT EXISTS CachedPlace (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    address TEXT NOT NULL,
    region TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL
);

CREATE TABLE IF NOT EXISTS AuthToken (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    token TEXT NOT NULL
);

-- Teams
selectAllTeams:
SELECT * FROM CachedTeam;

insertTeam:
INSERT OR REPLACE INTO CachedTeam(id, name, logoUrl, leaderName, point, status)
VALUES (?, ?, ?, ?, ?, ?);

deleteAllTeams:
DELETE FROM CachedTeam;

-- Places
selectAllPlaces:
SELECT * FROM CachedPlace;

insertPlace:
INSERT OR REPLACE INTO CachedPlace(id, name, address, region, latitude, longitude)
VALUES (?, ?, ?, ?, ?, ?);

deleteAllPlaces:
DELETE FROM CachedPlace;

-- Token
selectToken:
SELECT token FROM AuthToken WHERE id = 1;

insertToken:
INSERT OR REPLACE INTO AuthToken(id, token) VALUES (1, ?);

deleteToken:
DELETE FROM AuthToken;
